        SELECT t.responselogid,distcode,activityid,nodetype,location,username,t.distnid,jsonb_strip_nulls(jsonb_object_agg(key, value)) AS merged_json,survey_source
    FROM (SELECT final2.responselogid,distcode,activityid,nodetype,location,username,final2.distnid,key,value,survey_source FROM final2 , LATERAL jsonb_each(grp_json)) t
