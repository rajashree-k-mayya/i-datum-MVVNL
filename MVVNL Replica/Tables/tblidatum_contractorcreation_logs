CREATE TABLE public.tblidatum_contractorcreation_logs (api_id           serial primary key,
                                                       contractorid     INT4 NULL,
                                                       roleid           INT4 NULL,
                                                       inchargeid       INT4 NULL,
                                                       source           TEXT NULL,
                                                       request_url      TEXT NULL,
                                                       request          VARCHAR(500000) NULL,
                                                       response         VARCHAR(500000) NULL,
                                                       description      VARCHAR(500) NULL,
                                                       status_created   BOOL DEFAULT false NULL,
                                                       status_updated   BOOL DEFAULT false NULL,
                                                       created_datetime TIMESTAMP(6) DEFAULT now() NULL,
                                                       inserted         BOOL DEFAULT false NULL,
                                                       updated          BOOL DEFAULT false NULL,
                                                       type_id          INT4 NULL,
                                                       push_datetime    TIMESTAMP(6) NULL);
